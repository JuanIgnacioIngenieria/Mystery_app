rules_version = '2';

// ---------------------------------------------------------------------------
// MYSTERY — Reglas de seguridad de Firestore
//
// Los clientes (app móvil) NUNCA leen ni escriben Firestore directamente:
// todo pasa por el backend con el SDK de Admin, que ignora estas reglas.
// Denegar todo garantiza que el código de invitación no permite sondar
// partidas y que ningún dato de una partida vale sin credencial privada.
//
// Desplegar:  firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
