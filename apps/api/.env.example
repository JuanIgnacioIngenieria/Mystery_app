# Backend — variables de entorno

# Puerto HTTP del backend (predictable para el cliente móvil en desarrollo)
PORT=4000

# Credenciales de la cuenta de servicio de Firebase (Google Cloud Console →
# IAM y administración → Cuentas de servicio → nueva clave JSON).
# SOLO viven en este archivo. Nunca se comprometen ni se envían al cliente móvil.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Pega la clave en una sola línea. Reemplaza los saltos de línea por \n literales.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
