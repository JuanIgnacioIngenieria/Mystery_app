# Backend — variables de entorno

# Puerto HTTP del backend (predictable para el cliente móvil en desarrollo)
PORT=4000

# Credenciales de la cuenta de servicio de Firebase (Google Cloud Console →
# IAM y administración → Cuentas de servicio → nueva clave JSON).
# SOLO viven en este archivo. Nunca se comprometen ni se envían al cliente móvil.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Pega la clave en una sola línea. Reemplaza los saltos de línea por \n literales.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"

# Generación del misterio con IA. Sin URL configurada, «Comenzar partida»
# responde 503 GENERATION_NOT_CONFIGURED con un mensaje controlado (la partida
# nunca queda bloqueada). Proveedor actual: DeepSeek (https://api-docs.deepseek.com)
# AI_GENERATION_URL=https://api.deepseek.com/chat/completions
# AI_GENERATION_API_KEY=tu-clave-privada-del-proveedor   # SOLO en apps/api/.env real
# AI_GENERATION_MODEL=deepseek-flash                     # alternativa: deepseek-v4-pro
# Selector de proveedor concreto: 'deepseek' | vacío = HTTP genérico (mock local).
# AI_GENERATION_PROVIDER=deepseek
# Modo thinking del modelo: 'enabled' (calidad) | 'disabled' (rápido y barato).
# AI_GENERATION_THINKING=enabled
# Tokens máximos de salida (el JSON del misterio es largo; no bajar demasiado).
# AI_GENERATION_MAX_TOKENS=65536
# Presupuesto máximo de espera del proveedor en ms (120000 por defecto).
# Con thinking mode + JSON largo, 420000 da margen suficiente.
# AI_GENERATION_TIMEOUT_MS=420000
